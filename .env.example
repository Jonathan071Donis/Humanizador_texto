# Copy this file to .env and adjust values for your environment.

# Server
PORT=8000
ENV=production

# Auth
SECRET_KEY=change-this-to-a-long-random-string
TOKEN_TTL_SECONDS=28800

# Optional light persistence for the in-memory user store.
# Leave unset to keep users purely in memory (lost on restart).
# USERS_JSON_FILE=users.json

# App
APP_NAME=Watermark Detector
CORS_ORIGINS=*

# Batch limits
MAX_BATCH_FILES=20
MAX_BATCH_TOTAL_MB=50

# Rate limiting
RATE_LIMIT_PER_MINUTE=10

# Set to true when served over HTTPS (e.g. on Render) so the session
# cookie is marked Secure.
COOKIE_SECURE=true
